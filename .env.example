# Local development (pnpm dev). Copy to .env at the repository root.
NODE_ENV=development
PUBLIC_URL=http://localhost:5173
DATABASE_URL=postgres://postgres:postgres@localhost:5432/vidfriends
APP_SECRET=dev-only-secret-change-me-0123456789
S3_ENDPOINT=http://localhost:8333
S3_PUBLIC_ENDPOINT=http://localhost:5173
S3_ACCESS_KEY_ID=devaccesskey
S3_SECRET_ACCESS_KEY=devsecretkey-not-for-production
LOG_LEVEL=debug
# For `pnpm test` storage tests (SeaweedFS from deploy/compose.dev.yml):
# TEST_S3_ENDPOINT=http://localhost:8333
# TEST_S3_ACCESS_KEY_ID=devaccesskey
# TEST_S3_SECRET_ACCESS_KEY=devsecretkey-not-for-production
