{
  "name": "@vidfriends/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch --env-file-if-exists=../../.env src/main.ts",
    "start": "node dist/main.js",
    "migrate": "node dist/main.js migrate",
    "db:generate": "drizzle-kit generate && node ../../scripts/check-migrations.mjs --update",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "env:docs": "tsx scripts/gen-env-docs.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1146.0",
    "@aws-sdk/s3-request-presigner": "3.1146.0",
    "@hono/node-server": "2.1.3",
    "@hono/zod-openapi": "1.6.3",
    "@simplewebauthn/server": "14.0.3",
    "@vidfriends/contracts": "workspace:*",
    "drizzle-orm": "0.45.3",
    "fflate": "0.8.3",
    "hono": "4.13.13",
    "pg": "8.23.1",
    "pg-boss": "12.36.0",
    "pino": "10.4.0",
    "prom-client": "15.1.3",
    "sharp": "0.35.5",
    "uuid": "14.0.3",
    "web-push": "3.6.7",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "@types/pg": "8.23.1",
    "@types/web-push": "3.6.4",
    "@vidfriends/config": "workspace:*",
    "@vidfriends/test-utils": "workspace:*",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "tsx": "4.23.15",
    "vitest": "5.0.3"
  },
  "files": [
    "dist",
    "drizzle",
    "assets"
  ]
}
