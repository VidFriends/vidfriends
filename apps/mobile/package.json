{
  "name": "@vidfriends/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "jest --passWithNoTests",
    "bundle": "expo export --platform android --platform ios --output-dir dist --no-minify"
  },
  "dependencies": {
    "@expo/vector-icons": "15.1.1",
    "@shopify/flash-list": "2.0.2",
    "@tanstack/react-query": "5.104.1",
    "@vidfriends/api-client": "workspace:*",
    "@vidfriends/contracts": "workspace:*",
    "expo": "57.0.26",
    "expo-build-properties": "57.0.22",
    "expo-camera": "57.0.6",
    "expo-constants": "57.0.20",
    "expo-crypto": "57.0.3",
    "expo-device": "57.0.2",
    "expo-image-picker": "57.0.20",
    "expo-linking": "57.0.11",
    "expo-localization": "57.0.2",
    "expo-notifications": "57.0.21",
    "expo-router": "57.0.24",
    "expo-secure-store": "57.0.4",
    "expo-share-intent": "8.0.1",
    "expo-status-bar": "57.0.1",
    "expo-system-ui": "57.0.4",
    "expo-video": "57.0.5",
    "expo-web-browser": "57.0.3",
    "i18next": "26.4.2",
    "react": "19.2.3",
    "react-i18next": "17.0.15",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.26.2"
  },
  "devDependencies": {
    "@testing-library/react-native": "14.0.1",
    "@types/jest": "30.0.0",
    "@types/react": "19.2.18",
    "@vidfriends/config": "workspace:*",
    "eslint": "9.39.5",
    "jest": "30.5.2",
    "jest-expo": "57.0.5",
    "typescript": "5.9.3"
  },
  "jest": {
    "preset": "jest-expo",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/e2e/"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!(\\.pnpm|((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@sentry/react-native|native-base|react-native-svg|@vidfriends/.*|zod))"
    ]
  }
}
