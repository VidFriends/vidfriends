{
  "name": "vidfriends",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test --concurrency=1",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "gen": "turbo run gen",
    "e2e": "node e2e/scripts/stack.mjs up --build && pnpm --filter @vidfriends/e2e e2e",
    "migrations:check": "node scripts/check-migrations.mjs",
    "e2e:down": "node e2e/scripts/stack.mjs down",
    "dev:services": "docker compose -f deploy/compose.dev.yml up -d --wait"
  },
  "devDependencies": {
    "prettier": "3.9.10",
    "turbo": "2.11.9",
    "typescript": "5.9.3"
  }
}
