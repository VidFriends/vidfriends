# Copy to deploy/.env and fill in every value. Never commit deploy/.env.
# Generate secrets with: openssl rand -hex 32   (hex keeps them URL-safe)

# Public host name and origin of your instance (TLS is automatic for public names).
DOMAIN=
PUBLIC_URL=

# PostgreSQL password (12+ characters, URL-safe).
POSTGRES_PASSWORD=

# 32+ random characters; signs CSRF tokens and encrypts instance secrets.
APP_SECRET=

# Credentials for the bundled SeaweedFS object store (ADR-0015).
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Released images (M5-T4). Pin an exact version; upgrade by changing it and following
# deploy/RUNBOOK.md "Upgrade". Leave unset only when building from source.
VIDFRIENDS_SERVER_IMAGE=ghcr.io/vidfriends/vidfriends-server:0.1.0
VIDFRIENDS_WORKER_IMAGE=ghcr.io/vidfriends/vidfriends-worker:0.1.0

# Optional
# LOG_LEVEL=info
# HTTP_PORT=80
# HTTPS_PORT=443
# RATE_LIMIT_AUTH_PER_MINUTE=10
