# VidFriends Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env files to version control.

# ---------- Server ----------
VIDFRIENDS_ADDR=:8080
VIDFRIENDS_READ_TIMEOUT=10
VIDFRIENDS_WRITE_TIMEOUT=30
VIDFRIENDS_SHUTDOWN_TIMEOUT=15

# ---------- Database ----------
# Change the password before deploying to production
VIDFRIENDS_DATABASE_URL=postgres://vidfriends:vidfriends@postgres:5432/vidfriends?sslmode=disable

# ---------- Auth / JWT ----------
# Generate a strong random secret for production: openssl rand -base64 32
VIDFRIENDS_JWT_SECRET=vidfriends-dev-secret-do-not-use-in-prod
# Duration format: number = seconds, or Go duration string like 15m, 24h
VIDFRIENDS_JWT_EXPIRY=15m
VIDFRIENDS_JWT_REFRESH_EXPIRY=168h

# ---------- S3 / Object Storage ----------
VIDFRIENDS_S3_ENDPOINT=http://minio:9000
VIDFRIENDS_S3_ACCESS_KEY=minioadmin
VIDFRIENDS_S3_SECRET_KEY=minioadmin
VIDFRIENDS_S3_BUCKET=vidfriends-videos
VIDFRIENDS_S3_REGION=
VIDFRIENDS_S3_PATH_STYLE=false
VIDFRIENDS_S3_USE_SSL=false

# ---------- Rate Limiting ----------
VIDFRIENDS_RATE_LIMIT_RATE=10
VIDFRIENDS_RATE_LIMIT_BURST=20

# ---------- Duplicate Detection ----------
VIDFRIENDS_DUPLICATE_THRESHOLD=12

# ---------- CORS ----------
# Comma-separated list of allowed origins
VIDFRIENDS_CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---------- Signup ----------
# Set to "true" to allow registration without an invite code
VIDFRIENDS_ALLOW_PUBLIC_SIGNUP=false

# ---------- Logging ----------
# Log level: debug, info, warn, error
VIDFRIENDS_LOG_LEVEL=info

# ---------- Eviction ----------
# Eviction strategy: age, storage, or both
VIDFRIENDS_EVICTION_STRATEGY=age
# Age in days before a video is eligible for eviction
VIDFRIENDS_EVICTION_AGE_DAYS=90
# Maximum storage in bytes (0 = unlimited)
VIDFRIENDS_MAX_STORAGE_BYTES=0

# ---------- YouTube OAuth (Playlist Import) ----------
# Create OAuth 2.0 credentials at https://console.cloud.google.com
VIDFRIENDS_YOUTUBE_CLIENT_ID=
VIDFRIENDS_YOUTUBE_CLIENT_SECRET=
# Must match the redirect URI registered in Google Cloud Console
VIDFRIENDS_YOUTUBE_REDIRECT_URI=http://localhost:8080/api/oauth/callback?provider=youtube

# ---------- GitHub App (Installation Tokens) ----------
# Used by backend agents/systems to mint short-lived installation access tokens
# instead of storing long-lived PATs.
# Create a GitHub App at https://github.com/settings/apps
VIDFRIENDS_GITHUB_APP_ID=
# Path to the GitHub App private key PEM file
VIDFRIENDS_GITHUB_PRIVATE_KEY_PATH=
# Installation ID of the GitHub App (found in the installation URL)
VIDFRIENDS_GITHUB_INSTALLATION_ID=
