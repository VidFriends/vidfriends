# VidFriends Caddyfile
# Replace vidfriends.example.com with your actual domain.
# Caddy will automatically provision TLS certificates via Let's Encrypt.

vidfriends.example.com {
    reverse_proxy api:8080 {
        health_uri /api/health
        health_port 8080
        health_interval 30s
        health_timeout 5s
    }

    log {
        output file /data/access.log
        format json
    }
}
