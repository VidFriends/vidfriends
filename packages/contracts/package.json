{
  "name": "@vidfriends/contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./openapi.json": "./openapi.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.scripts.json",
    "lint": "eslint .",
    "gen": "tsx scripts/gen-openapi.ts",
    "gen:check": "tsx scripts/gen-openapi.ts --check",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@asteasolutions/zod-to-openapi": "9.1.0",
    "@types/node": "^26.6.5",
    "@vidfriends/config": "workspace:*",
    "eslint": "9.39.5",
    "tsx": "4.23.15",
    "vitest": "5.0.3"
  }
}
