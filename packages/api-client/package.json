{
  "name": "@vidfriends/api-client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    },
    "./realtime": {
      "types": "./dist/realtime.d.ts",
      "default": "./dist/realtime.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@vidfriends/contracts": "workspace:*"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5",
    "react": ">=18"
  },
  "devDependencies": {
    "@tanstack/react-query": "5.104.1",
    "@types/react": "19.2.18",
    "@vidfriends/config": "workspace:*",
    "eslint": "10.13.0",
    "react": "19.2.3",
    "vitest": "5.0.3"
  }
}
